[Unit]
Description=Gold Trading Bot Oracle Agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=goldagent
Group=goldagent
WorkingDirectory=/opt/gold-agent
EnvironmentFile=/etc/gold-agent.env
Environment=HOME=/var/lib/gold-agent
ExecStart=/opt/gold-agent/venv/bin/python /opt/gold-agent/agent.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gold-agent /opt/gold-agent
[Install]
WantedBy=multi-user.target
