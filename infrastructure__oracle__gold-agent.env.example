APP_ENV=production
API_BASE_URL=https://your-api.example.com
AGENT_SHARED_SECRET=replace-with-long-random-secret
AGENT_ID=oracle-agent-01
AGENT_WORKSPACE=/var/lib/gold-agent/accounts
POLL_SECONDS=10
MT5_INSTALL_DIR=/opt/mt5
EA_SOURCE_DIR=/opt/gold-trading-bot/trading/ea
METAEDITOR_COMMAND=wine /opt/mt5/MetaEditor64.exe
# Linux Oracle host: use Wine or the supported launcher for MT5 terminal.
MT5_LAUNCH_COMMAND=wine
# Set AGENT_SECRET after one-time enrollment; bootstrap secret is only for enrollment.
AGENT_SECRET=
LOG_LEVEL=INFO
