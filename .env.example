# PostgreSQL connection string
# Render provides this automatically through render.yaml.
DATABASE_URL=postgresql://user:password@host:5432/database

# Long random string used to encrypt MT5 passwords.
# Generate a new private value; never share it or commit it.
SECRET_KEY=replace_with_long_random_private_string

# Shared secret used by Render to authenticate worker requests.
# Generate a separate long random value; never share it.
WORKER_SHARED_SECRET=replace_with_long_random_private_string

# Your Bolt website domain, comma-separated if needed.
ALLOWED_ORIGINS=https://your-bolt-website-domain.com

# Optional: restrict recognized license keys.
# Leave blank to recognize all four supported keys.
ALLOWED_LICENSES=BOSSMODE99,BOSSMODE98,BOSSMODE30D,BOSSMODE01D

# URL of your Windows MT5 worker. Add this after deploying the worker.
WORKER_API_URL=https://your-worker-url.com
