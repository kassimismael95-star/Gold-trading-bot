# Gold Scalper AI - Matrix Control
# Copy these values into Render Environment Variables.
# Never commit real secrets to GitHub.

# Application
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=https://your-bolt-website-url

# Database
DATABASE_URL=postgresql://username:password@host:5432/database

# Licence control
# All four licence codes are recognized by the control plane.
ALLOWED_LICENSES=BOSSMODE99,BOSSMODE98,BOSSMODE30D,BOSSMODE01D

# Worker security
WORKER_SHARED_SECRET=change-this-to-a-long-random-worker-secret

# Execution control
# Live trading must remain disabled until demo testing is complete.
ENABLE_LIVE_TRADING=false

# MT5 cloud execution
MT5_EXECUTION_MODE=demo
ORACLE_EXECUTION_ENABLED=false

# Optional monitoring
SENTRY_DSN=
