# Render control plane
SECRET_KEY=your-long-random-secret
DATABASE_URL=your-database-url
ENABLE_LIVE_TRADING=true
LIVE_TRADING_AUTHORIZED=false
WORKER_SHARED_SECRET=your-long-random-worker-secret

