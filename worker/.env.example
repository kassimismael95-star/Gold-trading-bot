# Render control plane URL
CONTROL_PLANE_URL=https://your-render-app.onrender.com

# Must exactly match WORKER_SHARED_SECRET in Render
WORKER_SHARED_SECRET=replace-with-strong-random-secret

# Unique ID for this Windows MT5 worker
WORKER_ID=worker-1

# Human-readable worker name
WORKER_NAME=Primary MT5 Worker

# URL where this worker accepts commands
WORKER_API_URL=http://localhost:9000

# MT5 account credentials
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-mt5-password
MT5_SERVER=YourBroker-Server

# Optional full path to terminal64.exe
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Worker timing settings
HEARTBEAT_INTERVAL_SECONDS=15
COMMAND_POLL_INTERVAL_SECONDS=2
MAX_CONCURRENT_COMMANDS=5
